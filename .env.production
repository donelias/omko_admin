APP_NAME="Omko Admin"
APP_ENV="production"
APP_KEY=base64:REEMPLAZA_CON_TU_CLAVE_GENERADA
APP_DEBUG="false"
APP_URL=https://tu-dominio.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db-host.ondigitalocean.com
DB_PORT=3306
DB_DATABASE=omko_admin
DB_USERNAME=root
DB_PASSWORD=tu-contraseña-segura

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu-usuario
MAIL_PASSWORD=tu-contraseña
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@omko.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_ASSET_URL=/

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=omko-admin.herokuapp.com
